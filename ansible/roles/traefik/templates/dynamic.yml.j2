# Configuration dynamique Traefik.
# L'application est routée via les labels Docker (cf. deploy-app.yml).
# Ce fichier gère le monitoring (grafana, sonarqube, prometheus, dashboard).

http:
{% if domain_name and not domain_wildcard_subdomains %}
  # ---------- MODE DUCKDNS : outils routés PAR CHEMINS sur le domaine unique ----------
  # DuckDNS gratuit = pas de sous-domaines → /grafana, /sonarqube, /prometheus, /dashboard
  middlewares:
    strip-grafana:
      stripPrefix:
        prefixes:
          - "{{ grafana_path }}"
    strip-dashboard:
      stripPrefix:
        prefixes:
          - "{{ traefik_dashboard_path }}"

  routers:
    sonarqube:
      rule: "Host(`{{ domain_name }}`) && PathPrefix(`{{ sonarqube_path }}`)"
      entryPoints:
        - websecure
      service: sonarqube-service
      tls:
        certResolver: letsencrypt

    grafana:
      rule: "Host(`{{ domain_name }}`) && PathPrefix(`{{ grafana_path }}`)"
      entryPoints:
        - websecure
      middlewares:
        - strip-grafana
      service: grafana-service
      tls:
        certResolver: letsencrypt

    prometheus:
      rule: "Host(`{{ domain_name }}`) && PathPrefix(`{{ prometheus_path }}`)"
      entryPoints:
        - websecure
      service: prometheus-service
      tls:
        certResolver: letsencrypt

    traefik-dashboard:
      rule: "Host(`{{ domain_name }}`) && PathPrefix(`{{ traefik_dashboard_path }}`)"
      entryPoints:
        - websecure
      middlewares:
        - strip-dashboard
      service: api@internal
      tls:
        certResolver: letsencrypt

  services:
    sonarqube-service:
      loadBalancer:
        servers:
          - url: "http://sonarqube:9000"

    prometheus-service:
      loadBalancer:
        servers:
          - url: "http://prometheus:9090"

    grafana-service:
      loadBalancer:
        servers:
          - url: "http://grafana:3000"

{% elif domain_name %}
  # ---------- MODE SOUS-DOMAINES (domaine avec wildcard / sous-domaines DNS) ----------
  routers:
    sonarqube:
      rule: "Host(`{{ sonarqube_host }}`)"
      entryPoints:
        - websecure
      service: sonarqube-service
      tls:
        certResolver: letsencrypt

    traefik-dashboard:
      rule: "Host(`{{ traefik_host }}`)"
      entryPoints:
        - websecure
      service: api@internal
      tls:
        certResolver: letsencrypt

    prometheus:
      rule: "Host(`prometheus.{{ domain_name }}`)"
      entryPoints:
        - websecure
      service: prometheus-service
      tls:
        certResolver: letsencrypt

    grafana:
      rule: "Host(`grafana.{{ domain_name }}`)"
      entryPoints:
        - websecure
      service: grafana-service
      tls:
        certResolver: letsencrypt

  services:
    sonarqube-service:
      loadBalancer:
        servers:
          - url: "http://sonarqube:9000"

    prometheus-service:
      loadBalancer:
        servers:
          - url: "http://prometheus:9090"

    grafana-service:
      loadBalancer:
        servers:
          - url: "http://grafana:3000"
{% else %}
  # Sans domaine : dashboard Traefik accessible via le port 8080 uniquement
  routers:
    traefik-dashboard:
      rule: "HostRegexp(`{any:.*}`)"
      entryPoints:
        - traefik
      service: api@internal
{% endif %}