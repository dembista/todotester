version: "3.8"

services:
  grafana:
    image: grafana/grafana:11.0.0
    container_name: grafana
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: "{{ grafana_public_url }}"
      GF_SERVER_SERVE_FROM_SUB_PATH: "{{ 'true' if grafana_serve_from_sub_path else 'false' }}"
      GF_ALERTING_ENABLED: "true"
      GF_ALERTING_DEFAULT_RULE_INTERVAL: "15s"
    volumes:
      - /opt/grafana/data:/var/lib/grafana
      - /opt/grafana/provisioning:/etc/grafana/provisioning:ro
    networks:
      - traefik

networks:
  traefik:
    external: true